# Настройки базы данных
# Укажите правильные параметры для подключения к вашей PostgreSQL базе данных на Timeweb
DATABASE_URL="postgresql://username:password@hostname:port/database?schema=public"

# Настройки приложения
NODE_ENV="production"
PORT=3001

# Настройки CORS, укажите домен вашего сайта
CORS_ORIGIN="https://ваш-домен.ru"

# Максимальный размер загрузки файлов (10MB)
MAX_FILE_SIZE=10485760 